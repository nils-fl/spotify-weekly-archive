# --- Spotify Web API app (used to write to your archive playlist) ------------
# Create an app at https://developer.spotify.com/dashboard
# Register the redirect URI as exactly: http://127.0.0.1:8888/callback
# Spotify rejects the hostname "localhost" -- it must be the loopback IP.
# Development Mode is fine, but note it requires the app owner to have an
# active Spotify Premium subscription, and caps the app at 5 allowlisted users.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Playlists ---------------------------------------------------------------
# Source: the playlist to copy FROM. Typically your own Discover Weekly.
# Open it in Spotify -> Share -> Copy link, and take the id from the URL:
#   https://open.spotify.com/playlist/<THIS_PART>?si=...
# Discover Weekly ids are per-user, so yours will not match anyone else's.
SOURCE_PLAYLIST_ID=

# Target: the playlist to copy INTO. Must be a playlist you own, otherwise the
# Web API will refuse to modify it.
ARCHIVE_PLAYLIST_ID=

# --- Credential file paths ---------------------------------------------------
# Relative paths are resolved against the project root.
#
# LIBRESPOT_CREDENTIALS: a librespot session file with the shape
#   {"username": "...", "credentials": "...", "type": "..."}
# Produced by librespot or by tools built on it. Never written to by this
# project (store_credentials is disabled).
LIBRESPOT_CREDENTIALS=credentials.json

# API_CREDENTIALS: written by `python src/auth.py`, holds the refresh token.
API_CREDENTIALS=api-credentials.json
